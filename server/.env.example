PORT=3000

HOST=0.0.0.0

JWT_SECRET="replace_with_a_long_random_secret_before_starting"

JWT_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:5173"

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/studyflow"

# Optional: configure all three values together to enable Google OAuth.
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Must use the same origin as FRONTEND_URL. Default: /auth/google/callback.
# GOOGLE_FRONTEND_CALLBACK_URL="http://localhost:5173/auth/google/callback"

# Optional separate database for integration tests. Otherwise tests create a
# temporary sf_oauth_test_* schema in DATABASE_URL and remove only that schema.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/studyflow_test"

# Optional: required only for custom avatar uploads, not local default avatars.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
