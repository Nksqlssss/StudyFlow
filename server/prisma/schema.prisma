generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubjectIcon {
  code
  math
  language
  paint
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum Theme {
  dark
  light
}

enum CardDensity {
  comfortable
  compact
}

enum Language {
  ru
  en
  pl
}

enum CompletedTasksVisibility {
  tab_only
  active_list
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings UserSettings?
  subjects Subject[]
  tasks    Task[]
}

model UserSettings {
  id                       String                   @id @default(uuid())
  userId                   String                   @unique
  theme                    Theme                    @default(dark)
  cardDensity              CardDensity              @default(comfortable)
  showTips                 Boolean                  @default(true)
  language                 Language                 @default(ru)
  defaultTaskPriority      TaskPriority             @default(medium)
  urgentThresholdHours     Int                      @default(24)
  completedTasksVisibility CompletedTasksVisibility @default(tab_only)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id        String      @id @default(uuid())
  userId    String
  title     String
  icon      SubjectIcon @default(code)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Task {
  id          String       @id @default(uuid())
  userId      String
  subjectId   String
  title       String
  description String?
  deadline    DateTime?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])
}
