generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubjectIcon {
  code
  math
  language
  paint
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum Theme {
  dark
  light
}

enum CardDensity {
  comfortable
  compact
}

enum Language {
  ru
  en
  pl
}

enum CompletedTasksVisibility {
  tab_only
  active_list
}

enum ReauthPurpose {
  set_password
  change_email
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?

  name      String
  username  String?   @unique
  avatarUrl String?
  birthDate DateTime?
  isPublic  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  settings                UserSettings?
  subjects                Subject[]
  tasks                   Task[]
  emailVerificationTokens  EmailVerificationToken[]
  oauthAccounts           OAuthAccount[]
  googleOAuthStates       GoogleOAuthState[]
  googleOAuthExchanges    GoogleOAuthExchange[]
  emailChangeToken        EmailChangeToken?
  reauthChallenge         ReauthChallenge?
  reauthTokens            ReauthToken[]
  sessionRevocations      SessionRevocation[]
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleExchanges GoogleOAuthExchange[]

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model GoogleOAuthState {
  stateHash     String   @id
  browserHash   String
  nonceHash     String
  codeChallenge String
  intent        String
  userId        String?
  sessionHash   String?
  expiresAt     DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model GoogleOAuthExchange {
  codeHash       String   @id
  browserHash    String
  userId         String
  oauthAccountId String
  expiresAt      DateTime

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAccount OAuthAccount @relation(fields: [oauthAccountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([oauthAccountId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailChangeToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReauthChallenge {
  userId                String        @id
  purpose               ReauthPurpose
  sessionHash           String
  email                 String
  nonce                 String
  codeHash              String?
  expiresAt             DateTime
  lastSentAt            DateTime
  sendWindowStartedAt   DateTime
  sendCount             Int           @default(1)
  attemptWindowStartedAt DateTime
  failedAttempts        Int           @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReauthToken {
  tokenHash   String        @id
  userId      String
  purpose     ReauthPurpose
  sessionHash String
  email       String
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SessionRevocation {
  sessionHash String   @id
  userId      String
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id                       String                   @id @default(uuid())
  userId                   String                   @unique
  theme                    Theme                    @default(dark)
  cardDensity              CardDensity              @default(comfortable)
  showTips                 Boolean                  @default(true)
  language                 Language                 @default(ru)
  defaultTaskPriority      TaskPriority             @default(medium)
  urgentThresholdHours     Int                      @default(24)
  completedTasksVisibility CompletedTasksVisibility @default(tab_only)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id        String      @id @default(uuid())
  userId    String
  title     String
  icon      SubjectIcon @default(code)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Task {
  id          String       @id @default(uuid())
  userId      String
  subjectId   String
  title       String
  description String?
  deadline    DateTime?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])
}
